# Mercado Pago Connect (OAuth)
# Crie um app em: https://applications.mercadopago.com
# Redirect URI: https://seu-dominio.com/api/integracoes/mercadopago/callback/
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://seu-dominio.com/api/integracoes/mercadopago/callback/
# Segredo para validar assinatura HMAC do webhook (escolha um aleatório forte)
MERCADOPAGO_WEBHOOK_SECRET=
# Chave Fernet para criptografar tokens em repouso (32 bytes url-safe base64)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MERCADOPAGO_FERNET_KEY=
INVITE_CODE=generate-a-long-random-invite-code
# Domínio público do site (para notification_url do MP)
SITE_URL=https://seu-dominio.com
